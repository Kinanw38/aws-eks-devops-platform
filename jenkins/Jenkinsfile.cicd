pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: docker
    image: docker:dind
    securityContext:
      privileged: true
    env:
    - name: DOCKER_TLS_CERTDIR
      value: ""
    - name: DOCKER_HOST
      value: "tcp://localhost:2375"
    volumeMounts:
    - name: dind-storage
      mountPath: /var/lib/docker
  - name: kubectl
    image: bitnami/kubectl:latest
    command: ['cat']
    tty: true
  volumes:
  - name: dind-storage
    emptyDir: {}
'''
        }
    }
    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials-id')
        REGISTRY = 'ronkdev/devops-rest-api'
        IMAGE_TAG = "v${BUILD_NUMBER}"
    }
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        stage('Build & Push Docker Image') {
            steps {
                container('docker') {
                    sh '''
                        # המתנה לזמינות מלאה של Docker Daemon לפני התחלת העבודה
                        echo "Waiting for Docker Daemon to be ready..."
                        until docker info >/dev/null 2>&1; do sleep 1; done

                        docker login -u $DOCKERHUB_CREDENTIALS_USR -p $DOCKERHUB_CREDENTIALS_PSW
                        docker build -t $REGISTRY:$IMAGE_TAG ./docker
                        docker push $REGISTRY:$IMAGE_TAG
                        docker tag $REGISTRY:$IMAGE_TAG $REGISTRY:latest
                        docker push $REGISTRY:latest
                    '''
                }
            }
        }
        stage('Deploy to Kubernetes') {
            steps {
                container('kubectl') {
                    sh '''
                        kubectl set image deployment/devops-rest-api rest-api=$REGISTRY:$IMAGE_TAG -n devops
                        kubectl rollout status deployment/devops-rest-api -n devops
                    '''
                }
            }
        }
    }
}